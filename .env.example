# Chave de API do Pexels (https://www.pexels.com/api/)
# Fonte principal das imagens de capa dos artigos.
PEXELS_API_KEY=

# Chave de API do Pixabay (https://pixabay.com/api/docs/)
# Usada como segunda opção quando o Pexels não retorna resultado.
PIXABAY_API_KEY=

# Sem nenhuma das duas chaves, o site usa uma capa ilustrada gerada
# localmente (fallback) — ver components/CoverImage.tsx.

# Google AdSense (preencha só depois da aprovação da conta).
# ID do publisher, formato ca-pub-XXXXXXXXXXXXXXXX. Com ele definido o site
# passa a: incluir a meta google-adsense-account, mostrar o aviso de cookies
# (LGPD) e carregar o script de anúncios após o consentimento.
NEXT_PUBLIC_ADSENSE_CLIENT=

# IDs das unidades de anúncio criadas no painel (só números). Cada formato só
# renderiza quando o seu ID existir; sem ID, nada aparece (nada de caixa vazia).
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=

# Google Analytics 4. Já vem com o ID do site por padrão; deixe vazio para desligar.
# O gtag só carrega depois da escolha no aviso de cookies (Modo de Consentimento v2).
NEXT_PUBLIC_GA_ID=

# --- SEO (npm run seo:report) ---
# Chave JSON (uma linha só) da conta de serviço do Google Cloud usada para ler
# o Search Console e a Analytics Data API. A mesma conta precisa ter sido
# adicionada como usuária/leitora nas duas ferramentas.
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=

# ID numérico da propriedade GA4 (Administrador > Detalhes da propriedade).
GOOGLE_ANALYTICS_PROPERTY_ID=

# Chave de API (sem OAuth) para a PageSpeed Insights API.
GOOGLE_PAGESPEED_API_KEY=

# --- Formulário de contato (/contato, app/api/contato/route.ts) ---
# Chave de API do Resend (https://resend.com/api-keys), usada para enviar o
# e-mail do formulário de contato para o endereço em lib/author.ts. Sem essa
# chave, o formulário responde com erro 503 (não derruba o resto do site).
RESEND_API_KEY=
